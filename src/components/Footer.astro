---
import { socialLinks } from '../data/social';
import { author } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="border-t border-ink/10">
  <div
    class="mx-auto flex max-w-3xl flex-col gap-2 px-4 py-8 text-sm text-ink/60 md:flex-row md:items-center md:justify-between md:gap-6"
  >
    <p class="whitespace-nowrap">&copy; {year} {author.name}</p>
    <div class="flex flex-wrap gap-x-4 gap-y-1 md:flex-nowrap">
      <a href="/rss.xml" class="hover:text-accent">RSS</a>
      {
        socialLinks.map((link) => (
          <a href={link.href} class="hover:text-accent" target="_blank" rel="noopener noreferrer">
            {link.label}
          </a>
        ))
      }
    </div>
  </div>
</footer>
