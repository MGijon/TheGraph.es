---
import { socialLinks } from '../data/social';

const year = new Date().getFullYear();
---

<footer class="border-t border-ink/10">
  <div
    class="mx-auto flex max-w-3xl flex-col gap-2 px-4 py-8 text-sm text-ink/60 sm:flex-row sm:items-center sm:justify-between"
  >
    <p>&copy; {year} Manuel Gijón. All rights reserved.</p>
    <div class="flex flex-wrap gap-4">
      <a href="/rss.xml" class="hover:text-accent">RSS</a>
      {
        socialLinks.map((link) => (
          <a href={link.href} class="hover:text-accent" target="_blank" rel="noopener noreferrer">
            {link.label}
          </a>
        ))
      }
    </div>
  </div>
</footer>
