---
import ThemeToggle from './ThemeToggle';

const navItems = [
  { href: '/', label: 'Home' },
  { href: '/writing', label: 'Writing' },
  { href: '/projects', label: 'Projects' },
  { href: '/research', label: 'Research' },
  { href: '/about', label: 'About' }
];

const currentPath = Astro.url.pathname;

function isActive(href: string) {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<header class="border-b border-ink/10">
  <nav class="mx-auto flex max-w-3xl items-center justify-between px-4 py-5">
    <a href="/" class="font-mono text-sm font-semibold tracking-tight text-ink">
      thegraph<span class="text-accent">.es</span>
    </a>
    <div class="flex items-center gap-6">
      <ul class="flex gap-5 text-sm">
        {navItems.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={[
                'transition-colors hover:text-accent',
                isActive(item.href) ? 'text-accent font-medium' : 'text-ink/70'
              ]}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
      <ThemeToggle client:only="react" />
    </div>
  </nav>
</header>
