---
import { getCollection } from 'astro:content';

interface Props {
  collection: 'writing' | 'research' | 'speak';
  id: string;
}

const { collection, id } = Astro.props;
const ref = `${collection}/${id}`;

// Reverse of a project's `related` list: every published project that points here.
const projects = (
  await getCollection('projects', ({ data }) => !data.draft && data.related.includes(ref))
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const categoryLabel = {
  engineering: 'Engineering project',
  venture: 'Venture',
} as const;
---

{
  projects.length > 0 && (
    <section class="not-prose mt-16 border-t border-ink/10 pt-8">
      <h2 class="text-xl font-semibold text-ink">Related projects</h2>
      <ul class="mt-4 divide-y divide-ink/10">
        {projects.map((project) => (
          <li class="py-4">
            <a href={`/projects/${project.id}`} class="group flex flex-col gap-1">
              <span class="font-medium text-ink group-hover:text-accent">{project.data.title}</span>
              <span class="text-sm text-ink/50">{categoryLabel[project.data.category]}</span>
              <span class="text-sm text-ink/70">{project.data.description}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )
}
