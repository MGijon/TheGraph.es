---
import { getEntry } from 'astro:content';
import { getSeriesPosts } from '../lib/series';

interface Props {
  seriesId: string;
  currentId: string;
}

const { seriesId, currentId } = Astro.props;
const series = await getEntry('series', seriesId);
const posts = await getSeriesPosts(seriesId);
const index = posts.findIndex((post) => post.id === currentId);
---

{
  series && (
    <aside class="not-prose mb-10 rounded-lg border border-ink/10 p-5">
      <p class="text-sm text-ink/60">
        Part {index + 1} of {posts.length} in the series
      </p>
      <a
        href={`/writing/series/${series.id}`}
        class="mt-1 block font-semibold text-ink hover:text-accent"
      >
        {series.data.title}
      </a>
      <ol class="mt-3 space-y-1 text-sm">
        {posts.map((post, i) => (
          <li class="flex gap-2">
            <span class="w-5 shrink-0 text-ink/40">{i + 1}.</span>
            {post.id === currentId ? (
              <span class="font-medium text-accent" aria-current="page">
                {post.data.title}
              </span>
            ) : (
              <a href={`/writing/${post.id}`} class="text-ink/70 hover:text-accent">
                {post.data.title}
              </a>
            )}
          </li>
        ))}
      </ol>
    </aside>
  )
}
