---
import BaseLayout from './BaseLayout.astro';
import { tagSlug } from '../lib/tags';

interface Props {
  title: string;
  description: string;
  date: Date;
  tags?: string[];
  image?: string;
  /** Section list page (e.g. "/writing"); when set, tags link to it filtered by that tag. */
  tagBase?: string;
}

const { title, description, date, tags = [], image, tagBase } = Astro.props;

const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={title} description={description} image={image} article published={date}>
  <article class="prose prose-neutral dark:prose-invert max-w-none">
    <header class="not-prose mb-10">
      <h1 class="text-3xl font-bold tracking-tight text-ink sm:text-4xl">{title}</h1>
      <div class="mt-3 flex flex-wrap items-center gap-3 text-sm text-ink/60">
        <time datetime={date.toISOString()}>{formattedDate}</time>
        {
          tags.length > 0 && (
            <>
              <span aria-hidden="true">&middot;</span>
              <ul class="flex flex-wrap gap-2">
                {tags.map((tag) => (
                  <li>
                    {tagBase ? (
                      <a
                        href={`${tagBase}?tag=${tagSlug(tag)}`}
                        class="block rounded-full bg-ink/5 px-2 py-0.5 text-xs transition-colors hover:bg-accent/10 hover:text-accent"
                      >
                        {tag}
                      </a>
                    ) : (
                      <span class="block rounded-full bg-ink/5 px-2 py-0.5 text-xs">{tag}</span>
                    )}
                  </li>
                ))}
              </ul>
            </>
          )
        }
      </div>
      <slot name="meta" />
    </header>
    <slot />
  </article>
</BaseLayout>
