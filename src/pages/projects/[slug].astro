---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import ExternalLinks from '../../components/ExternalLinks.astro';
import RelatedEntries from '../../components/RelatedEntries.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => !data.draft);
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<ArticleLayout
  title={project.data.title}
  description={project.data.description}
  date={project.data.date}
  tags={project.data.tags}
  tagBase="/projects"
>
  <ExternalLinks
    slot="meta"
    links={[
      { href: project.data.repoUrl, label: 'Code' },
      { href: project.data.liveUrl, label: 'Live' },
    ]}
  />
  <Content />
  <RelatedEntries collection="projects" id={project.id} />
</ArticleLayout>
