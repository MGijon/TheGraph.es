---
import { getCollection, getEntry, render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => !data.draft);
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);

const sectionLabel = {
  writing: 'Writing',
  research: 'Research',
  speak: 'Speak',
} as const;

type RelatedCollection = keyof typeof sectionLabel;

const related = (
  await Promise.all(
    project.data.related.map(async (ref) => {
      const slash = ref.indexOf('/');
      const collection = ref.slice(0, slash) as RelatedCollection;
      const id = ref.slice(slash + 1);
      const entry = await getEntry(collection, id);
      if (!entry) {
        throw new Error(`Project "${project.id}" lists related entry "${ref}", which does not exist.`);
      }
      // Drafts have no page, so leave them out instead of linking to a 404.
      if (entry.data.draft) return null;
      return {
        href: `/${collection}/${id}`,
        title: entry.data.title,
        date: entry.data.date,
        label: sectionLabel[collection],
      };
    })
  )
).filter((item) => item !== null);
---

<ArticleLayout
  title={project.data.title}
  description={project.data.description}
  date={project.data.date}
  tags={project.data.tags}
>
  <Content />
  {
    related.length > 0 && (
      <section class="not-prose mt-16 border-t border-ink/10 pt-8">
        <h2 class="text-xl font-semibold text-ink">Related</h2>
        <ul class="mt-4 divide-y divide-ink/10">
          {related.map((item) => (
            <li class="py-4">
              <a href={item.href} class="group flex flex-col gap-1">
                <span class="font-medium text-ink group-hover:text-accent">{item.title}</span>
                <span class="text-sm text-ink/50">
                  {item.label}
                  {' · '}
                  <time datetime={item.date.toISOString()}>
                    {item.date.toLocaleDateString('en-US', {
                      year: 'numeric',
                      month: 'short',
                      day: 'numeric',
                    })}
                  </time>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</ArticleLayout>
