---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const notes = (await getCollection('research', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<BaseLayout title="Research" description="Deeper dives and reading notes.">
  <h1 class="text-3xl font-bold tracking-tight">Research</h1>
  <ul class="mt-10 divide-y divide-ink/10">
    {
      notes.map((note) => (
        <li class="py-6">
          <a href={`/research/${note.id}`} class="group block">
            <div class="flex flex-wrap items-baseline justify-between gap-2">
              <h2 class="text-lg font-semibold group-hover:text-accent">{note.data.title}</h2>
              <time datetime={note.data.date.toISOString()} class="text-sm text-ink/50">
                {note.data.date.toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'short',
                  day: 'numeric',
                })}
              </time>
            </div>
            <p class="mt-2 text-sm text-ink/70">{note.data.description}</p>
          </a>
        </li>
      ))
    }
  </ul>
  {notes.length === 0 && <p class="mt-10 text-sm text-ink/60">Nothing published yet.</p>}
</BaseLayout>
