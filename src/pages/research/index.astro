---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TagFilter from '../../components/TagFilter.astro';
import { collectTags, tagData } from '../../lib/tags';

const notes = (await getCollection('research', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const tags = collectTags(notes);
---

<BaseLayout title="Research" description="Deeper dives and reading notes.">
  <h1 class="text-3xl font-bold tracking-tight">Research</h1>
  <TagFilter tags={tags} />
  <ul class="mt-10 divide-y divide-ink/10">
    {
      notes.map((note) => (
        <li class="py-6" data-filter-item data-tags={tagData(note.data.tags)}>
          <a href={`/research/${note.id}`} class="group block">
            <div class="flex flex-col gap-1">
              <h2 class="text-lg font-semibold group-hover:text-accent">{note.data.title}</h2>
              <time datetime={note.data.date.toISOString()} class="text-sm text-ink/50">
                {note.data.date.toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'short',
                  day: 'numeric',
                })}
              </time>
            </div>
            <p class="mt-2 text-sm text-ink/70">{note.data.description}</p>
            {note.data.tags.length > 0 && (
              <ul class="mt-3 flex flex-wrap gap-2">
                {note.data.tags.map((tag) => (
                  <li class="rounded-full bg-ink/5 px-2 py-0.5 text-xs text-ink/60">{tag}</li>
                ))}
              </ul>
            )}
          </a>
        </li>
      ))
    }
  </ul>
  <p data-filter-empty hidden class="mt-10 text-sm text-ink/60">Nothing tagged with that yet.</p>
  {notes.length === 0 && <p class="mt-10 text-sm text-ink/60">Nothing published yet.</p>}
</BaseLayout>
