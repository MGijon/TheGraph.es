---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const entries = await getCollection('speak', ({ data }) => !data.draft);

// "Upcoming" is evaluated at build time; past entries move over on the next deploy.
const today = new Date();
today.setHours(0, 0, 0, 0);

const upcoming = entries
  .filter((e) => e.data.date >= today)
  .sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());
const past = entries
  .filter((e) => e.data.date < today)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const sections = [
  { heading: 'Upcoming', items: upcoming },
  { heading: 'Past', items: past },
].filter((s) => s.items.length > 0);

const kindLabel: Record<string, string> = {
  talk: 'Talk',
  workshop: 'Workshop',
  panel: 'Panel',
  podcast: 'Podcast',
  interview: 'Interview',
  other: 'Session',
};
---

<BaseLayout title="Speak" description="Talks, workshops, and other public appearances.">
  <h1 class="text-3xl font-bold tracking-tight">Speak</h1>
  <p class="mt-4 max-w-xl text-ink/70">
    Talks, workshops, panels, and other public appearances — past and upcoming.
  </p>
  {
    sections.map((section) => (
      <section class="mt-12">
        <h2 class="text-xl font-semibold">{section.heading}</h2>
        <ul class="mt-4 divide-y divide-ink/10">
          {section.items.map((entry) => (
            <li class="py-6">
              <a href={`/speak/${entry.id}`} class="group block">
                <div class="flex flex-col gap-1">
                  <h3 class="text-lg font-semibold group-hover:text-accent">{entry.data.title}</h3>
                  <p class="text-sm text-ink/50">
                    <time datetime={entry.data.date.toISOString()}>
                      {entry.data.date.toLocaleDateString('en-US', {
                        year: 'numeric',
                        month: 'short',
                        day: 'numeric',
                      })}
                    </time>
                    {' · '}
                    {kindLabel[entry.data.kind]} at {entry.data.event}
                    {entry.data.location && ` · ${entry.data.location}`}
                  </p>
                </div>
                <p class="mt-2 text-sm text-ink/70">{entry.data.description}</p>
                {entry.data.tags.length > 0 && (
                  <ul class="mt-3 flex flex-wrap gap-2">
                    {entry.data.tags.map((tag) => (
                      <li class="rounded-full bg-ink/5 px-2 py-0.5 text-xs text-ink/60">{tag}</li>
                    ))}
                  </ul>
                )}
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
  {entries.length === 0 && <p class="mt-10 text-sm text-ink/60">Nothing published yet.</p>}
</BaseLayout>
