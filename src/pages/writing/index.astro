---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TagFilter from '../../components/TagFilter.astro';
import { collectTags, tagData } from '../../lib/tags';

const posts = (await getCollection('writing', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const tags = collectTags(posts);

const seriesTitles = new Map(
  (await getCollection('series')).map((series) => [series.id, series.data.title])
);
---

<BaseLayout
  title="Writing"
  description="Notes on data engineering, distributed systems, and performance."
>
  <h1 class="text-3xl font-bold tracking-tight">Writing</h1>
  <TagFilter tags={tags} />
  <ul class="mt-10 divide-y divide-ink/10">
    {
      posts.map((post) => (
        <li class="py-6" data-filter-item data-tags={tagData(post.data.tags)}>
          <a href={`/writing/${post.id}`} class="group block">
            <div class="flex flex-col gap-1">
              <h2 class="text-lg font-semibold group-hover:text-accent">{post.data.title}</h2>
              <time datetime={post.data.date.toISOString()} class="text-sm text-ink/50">
                {post.data.date.toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'short',
                  day: 'numeric',
                })}
              </time>
            </div>
            {post.data.series && (
              <p class="mt-1 text-sm text-ink/50">
                Series: {seriesTitles.get(post.data.series.id)}
                {post.data.seriesOrder && ` · Part ${post.data.seriesOrder}`}
              </p>
            )}
            <p class="mt-2 text-sm text-ink/70">{post.data.description}</p>
            {post.data.tags.length > 0 && (
              <ul class="mt-3 flex flex-wrap gap-2">
                {post.data.tags.map((tag) => (
                  <li class="rounded-full bg-ink/5 px-2 py-0.5 text-xs text-ink/60">{tag}</li>
                ))}
              </ul>
            )}
          </a>
        </li>
      ))
    }
  </ul>
  <p data-filter-empty hidden class="mt-10 text-sm text-ink/60">Nothing tagged with that yet.</p>
</BaseLayout>
